{
  "manifest_version": 3,
  "name": "予想ビューア 印・買い目転記",
  "version": "1.3.1",
  "description": "予想ビューアから、netkeiba の出馬表に印を自動で付ける(裏のタブ)・IPAT 連動馬券購入の画面に買い目を入れる(購入は自分で押す)。PC の Chrome 用。",
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://race.netkeiba.com/race/shutuba.html*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://race.netkeiba.com/ipat/ipat.html*"
      ],
      "js": [
        "bets.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:8770/*",
        "http://127.0.0.1:8770/*",
        "https://itry967.github.io/chimpo/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}