{
  "manifest_version": 3,
  "name": "予想ビューア 印転記",
  "version": "1.1.0",
  "description": "予想ビューアの「netkeiba に印を転記」で、netkeiba の出馬表に印を自動で付ける(PC の Chrome 用。裏のタブで転記して自動で閉じる)。",
  "icons": { "32": "icon32.png", "128": "icon128.png" },
  "permissions": ["tabs"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["https://race.netkeiba.com/race/shutuba.html*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:8770/*", "http://127.0.0.1:8770/*", "https://itry967.github.io/chimpo/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
